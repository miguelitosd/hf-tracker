#!/usr/bin/env python3
"""Back up / restore the HF tracker sqlite3 database.  Runs on the host (no container needed)
and is safe while the service is running: it uses sqlite's online backup API, which takes
proper locks instead of copying the file mid-write.

  hf-backup backup  [--keep N]        snapshot -> backups/tracker-YYYYmmdd-HHMMSS.db.gz
  hf-backup list                      show available backups
  hf-backup restore FILE|latest --yes replace the live data with a backup (current data is
                                      snapshotted first as tracker-...-pre-restore.db.gz)

Quiet on success (cron friendly); errors go to stderr with a non-zero exit.
Paths default to this repo (var/data/tracker.db, backups/); override with --db / --dir or
HF_DB / HF_BACKUP_DIR.

Example crontab line (nightly at 02:30, keep 60 snapshots):
  30 2 * * * /home/<USER>/git-work/hf-tracker/bin/hf-backup backup --keep 60
"""
import argparse
import datetime
import gzip
import os
import shutil
import sqlite3
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_DB = os.environ.get("HF_DB", os.path.join(REPO, "var", "data", "tracker.db"))
DEFAULT_DIR = os.environ.get("HF_BACKUP_DIR", os.path.join(REPO, "backups"))
PREFIX = "tracker-"
SUFFIX = ".db.gz"


class Failure(Exception):
    pass


def integrity_ok(path):
    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    try:
        return db.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
    except sqlite3.DatabaseError:
        return False
    finally:
        db.close()


def snapshot(db_path, out_dir, tag=""):
    """Online-backup db_path into a gzipped, integrity-checked file in out_dir; returns its path."""
    if not os.path.exists(db_path):
        raise Failure(f"database not found: {db_path}")
    os.makedirs(out_dir, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    dest = os.path.join(out_dir, f"{PREFIX}{stamp}{tag}{SUFFIX}")
    n = 1
    while os.path.exists(dest):  # two runs in the same second
        dest = os.path.join(out_dir, f"{PREFIX}{stamp}{tag}-{n}{SUFFIX}")
        n += 1

    with tempfile.TemporaryDirectory(dir=out_dir) as tmp:
        raw = os.path.join(tmp, "snapshot.db")
        src = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=30)
        dst = sqlite3.connect(raw)
        try:
            src.backup(dst)
        finally:
            dst.close()
            src.close()
        if not integrity_ok(raw):
            raise Failure(f"integrity check failed on snapshot of {db_path}")
        part = os.path.join(tmp, "snapshot.db.gz")
        with open(raw, "rb") as f, gzip.open(part, "wb") as g:
            shutil.copyfileobj(f, g)
        os.chmod(part, 0o600)
        os.replace(part, dest)
    return dest


def backups(out_dir):
    if not os.path.isdir(out_dir):
        return []
    names = sorted(n for n in os.listdir(out_dir) if n.startswith(PREFIX) and n.endswith(SUFFIX))
    return [os.path.join(out_dir, n) for n in names]


def prune(out_dir, keep):
    # Only regular snapshots count toward --keep; pre-restore safety copies are never pruned.
    regular = [p for p in backups(out_dir) if not p.endswith(f"-pre-restore{SUFFIX}")]
    for p in regular[:-keep] if keep > 0 else []:
        os.remove(p)


def cmd_backup(args):
    snapshot(args.db, args.dir)
    prune(args.dir, args.keep)


def cmd_list(args):
    found = backups(args.dir)
    if not found:
        print(f"no backups in {args.dir}")
    for p in found:
        st = os.stat(p)
        when = datetime.datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M:%S")
        print(f"{when}  {st.st_size:>9}  {os.path.basename(p)}")


def resolve(args):
    if args.file == "latest":
        regular = [p for p in backups(args.dir) if not p.endswith(f"-pre-restore{SUFFIX}")]
        if not regular:
            raise Failure(f"no backups in {args.dir}")
        return regular[-1]
    for cand in (args.file, os.path.join(args.dir, args.file)):
        if os.path.isfile(cand):
            return cand
    raise Failure(f"backup not found: {args.file}")


def cmd_restore(args):
    path = resolve(args)
    with tempfile.TemporaryDirectory() as tmp:
        raw = os.path.join(tmp, "restore.db")
        opener = gzip.open if path.endswith(".gz") else open
        try:
            with opener(path, "rb") as f, open(raw, "wb") as out:
                shutil.copyfileobj(f, out)
        except (OSError, EOFError) as e:
            raise Failure(f"cannot read {path}: {e}")
        if not integrity_ok(raw):
            raise Failure(f"{path} is not a valid sqlite database (integrity check failed)")
        rows = sqlite3.connect(raw).execute("SELECT count(*) FROM entries").fetchone()[0]

        if not args.yes:
            if not sys.stdin.isatty():
                raise Failure("refusing to restore without --yes when not interactive")
            ans = input(f"Replace {args.db} with {os.path.basename(path)} ({rows} entries)? [y/N] ")
            if ans.strip().lower() not in ("y", "yes"):
                print("aborted")
                return

        safety = snapshot(args.db, args.dir, tag="-pre-restore") if os.path.exists(args.db) else None
        # Copy pages into the live file through sqlite (with locking), so the running
        # service sees a consistent database and its open file stays valid.
        src = sqlite3.connect(raw)
        dst = sqlite3.connect(args.db, timeout=30)
        try:
            src.backup(dst)
        finally:
            dst.close()
            src.close()
    print(f"restored {args.db} from {path} ({rows} entries)")
    if safety:
        print(f"previous data saved as {safety}")


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog=__doc__.split("\n\n", 1)[1])
    p.add_argument("--db", default=DEFAULT_DB, help="database file (default: %(default)s)")
    p.add_argument("--dir", default=DEFAULT_DIR, help="backup directory (default: %(default)s)")
    sub = p.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("backup", help="take a snapshot")
    b.add_argument("--keep", type=int, default=30, help="snapshots to keep, 0 = all (default: %(default)s)")
    b.set_defaults(func=cmd_backup)
    sub.add_parser("list", help="list snapshots").set_defaults(func=cmd_list)
    r = sub.add_parser("restore", help="restore a snapshot over the live database")
    r.add_argument("file", help="backup file name/path, or 'latest'")
    r.add_argument("--yes", action="store_true", help="don't ask for confirmation")
    r.set_defaults(func=cmd_restore)
    args = p.parse_args()
    try:
        args.func(args)
    except (Failure, sqlite3.Error, OSError) as e:
        print(f"hf-backup: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
